# ---------------------------------------------------------------------------
# Chog Toolhub — environment (placeholders only; never commit a real .env)
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
# Public origin of the web app. Used as the SIWE domain/URI and for Origin checks. https in production.
APP_ORIGIN=http://localhost:5173
# Dev only: extra origins allowed to make state-changing requests (refused in production)
EXTRA_ORIGINS=

# Database. Leave empty in dev to use embedded PGlite at PGLITE_DIR. Required in production.
DATABASE_URL=
PGLITE_DIR=.data/pglite
DB_POOL_MAX=20

# Sessions / NFT gate
SESSION_TTL_HOURS=24
SESSION_CACHE_MS=5000
NFT_RECHECK_SEC=300
NFT_GRACE_SEC=900
# Chog Genesis on Monad mainnet (verified on-chain). Only change if the collection migrates.
NFT_GATE_CONTRACT=0xc96d31f8626c6d03fae5dcd3d61e3fb9f4a73763
NFT_GATE_NETWORK=monad
# DEV ONLY: comma-separated addresses allowed in without holding the NFT. Must be empty in production.
NFT_GATE_DEV_ALLOWLIST=

# RPC endpoints (comma-separated, first is preferred). Defaults are public, rate-limited endpoints.
RPC_MONAD=
RPC_BSC=
RPC_BASE=
RPC_ROBINHOOD=
RPC_ETHEREUM=
RPC_ARC=
RPC_INK=
RPC_HYPEREVM=
RPC_SOLANA=

# Optional: CoinGecko Pro key for GeckoTerminal on-chain data (raises the 30 req/min public limit)
COINGECKO_PRO_API_KEY=

# NFT → Top Collections: OpenSea API key (free: opensea.io → Account → Settings → Developer).
# Without it the page explains how to add one; everything else works.
OPENSEA_API_KEY=

# WalletConnect (Reown) project id — enables "Phone wallet" QR sign-in. Free at https://cloud.reown.com
WALLETCONNECT_PROJECT_ID=
# NFT → Mint Tracker: scans ERC-721 mints on Monad, Base and Robinhood Chain.
MINTS_ENABLED=true
# RPCs for the mint scan. They must allow eth_getLogs WITHOUT an address filter (mainnet.base.org and
# publicnode refuse it). Empty = built-in defaults (rpc.monad.xyz, base.drpc.org, Robinhood public RPC).
MINT_RPC_MONAD=
MINT_RPC_BASE=
MINT_RPC_ROBINHOOD=
MINT_RPC_ETHEREUM=

# Workers & limits
TRACKER_ENABLED=true
TRACKER_POLL_SEC=6
TRACKER_MAX_ADDRESSES_PER_NETWORK=500
NEWPOOLS_POLL_SEC=30
WS_MAX_PER_USER=8
JOURNAL_MAX_INFLIGHT_PER_USER=50
RATE_LIMIT_PER_MIN=600
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Optional bearer token (>= 32 chars) to scrape /internal/metrics remotely
METRICS_TOKEN=
LOG_LEVEL=info

# Reviewer / hackathon pass: anyone typing this code at sign-in gets in without the NFT (16-64 chars).
# Empty = off. Optional end date: JUDGE_ACCESS_UNTIL=2026-11-30T23:59:00Z (judge sessions end with it).
JUDGE_ACCESS_CODE=
JUDGE_ACCESS_UNTIL=
