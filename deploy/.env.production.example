# deploy/.env.production — settings of the app container (copy and fill in). Never commit the real file.
# Your domain, exactly as visitors open it (https, no trailing slash).
APP_ORIGIN=https://your-domain.xyz
SESSION_TTL_HOURS=24
LOG_LEVEL=info

# Market data / RPC (optional but recommended; see docs/DEPLOY.md)
COINGECKO_PRO_API_KEY=
RPC_MONAD=
RPC_BASE=
RPC_BSC=
RPC_ETHEREUM=
RPC_SOLANA=

# OpenSea: empty = automatic free-tier key (600 reads/h). A permanent key is faster.
OPENSEA_API_KEY=

# WalletConnect (Reown) project id — enables "Phone wallet" QR sign-in. Free at https://cloud.reown.com
WALLETCONNECT_PROJECT_ID=

TRACKER_ENABLED=true
MINTS_ENABLED=true
RATE_LIMIT_PER_MIN=600

# Reviewer / hackathon pass: anyone typing this code at sign-in gets in without the NFT (16-64 chars).
# Empty = off. Optional end date: JUDGE_ACCESS_UNTIL=2026-11-30T23:59:00Z (judge sessions end with it).
JUDGE_ACCESS_CODE=
JUDGE_ACCESS_UNTIL=
